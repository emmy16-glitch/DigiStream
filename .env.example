API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Leave blank for same-origin browser requests. Vite proxies /api to port 3000 in development.
VITE_API_URL=
# Google Identity Services web client ID. Leave blank to hide Google sign-in.
# Add localhost and the deployed DigiStream web origin as authorised JavaScript origins in Google Cloud.
GOOGLE_CLIENT_ID=
# Pinned browser media bundles. Production deployments may mirror these exact files on their own CDN.
VITE_LIVEKIT_CLIENT_MODULE_URL=https://cdn.jsdelivr.net/npm/livekit-client@2.21.0/dist/livekit-client.esm.mjs
VITE_OVENPLAYER_URL=https://cdn.jsdelivr.net/npm/ovenplayer@0.10.52/dist/ovenplayer.js
VITE_HLS_CLIENT_URL=https://cdn.jsdelivr.net/npm/hls.js@1.6.16/dist/hls.min.js
DATABASE_URL=postgresql://digistream:digistream@127.0.0.1:5432/digistream
DATABASE_POOL_MAX=10
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=digistream_session
AUTH_COOKIE_SECURE=false
ORGANISATION_INVITATION_TTL_SECONDS=604800
MEDIA_CONTROL_SECRET=replace-with-a-long-random-secret

# Private S3-compatible recording storage.
# The local Compose stack exposes SeaweedFS S3 at http://127.0.0.1:8333.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:8333
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=digistream-recordings
OBJECT_STORAGE_ACCESS_KEY_ID=digistream
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-a-long-random-storage-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MAX_UPLOAD_BYTES=268435456

# Stateless short-lived recording playback and download access.
# Use a distinct random secret with at least 32 bytes in production.
RECORDING_ACCESS_SECRET=replace-with-a-distinct-long-random-recording-access-secret
RECORDING_ACCESS_TTL_SECONDS=120

# Session-authenticated WebSocket origin policy.
# Production must provide explicit browser origins. Multiple values are comma-separated.
# The local Vite proxy presents http://localhost:5173 to the API, including from Codespaces.
REALTIME_ALLOWED_ORIGINS=http://localhost:5173
# Keep false for browser deployments. Enable only for explicitly trusted non-browser clients.
REALTIME_ALLOW_MISSING_ORIGIN=false

# Listener call-in status and abuse controls.
# Use a unique random value in production. It HMACs request fingerprints; raw IPs are not stored.
CALL_IN_FINGERPRINT_SECRET=replace-with-a-long-random-call-in-secret
CALL_IN_RATE_LIMIT_MAX=3
CALL_IN_RATE_LIMIT_WINDOW_SECONDS=1800
CALL_IN_STATUS_TTL_SECONDS=86400

# LiveKit creator, guest and audio-egress path.
# Browser clients receive LIVEKIT_URL. The API uses LIVEKIT_API_URL for RoomService and Egress.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=300
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SECONDS=60
LIVEKIT_ROOM_MAX_PARTICIPANTS=12
LIVEKIT_REQUEST_TIMEOUT_MS=5000

# OvenMediaEngine public delivery path.
OME_API_URL=http://127.0.0.1:8081
OME_API_ACCESS_TOKEN=replace-with-ome-api-access-token
OME_VHOST=default
OME_APP=live
OME_WEBRTC_BASE_URL=wss://media.example.test:3334
OME_LLHLS_BASE_URL=https://media.example.test:3334
OME_SIGNED_POLICY_SECRET=replace-with-ome-signed-policy-secret
OME_PLAYBACK_TTL_SECONDS=120

# Preferred bridge: LiveKit Egress pushes audio directly to OME using RTMP or SRT.
OME_INGEST_URL_TEMPLATE=rtmp://ovenmediaengine:1935/{app}/{streamName}

# Compatibility-only pull mode. Leave unset when OME_INGEST_URL_TEMPLATE is used.
# DELIVERY_RELAY_URL_TEMPLATE=rtsp://relay.internal:8554/{roomName}/{streamName}
