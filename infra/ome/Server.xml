<?xml version="1.0" encoding="UTF-8"?>
<Server version="8">
  <Name>DigiStream OME</Name>
  <Type>origin</Type>
  <IP>*</IP>
  <PrivacyProtection>false</PrivacyProtection>

  <Modules>
    <HTTP2>
      <Enable>false</Enable>
    </HTTP2>
    <LLHLS>
      <Enable>true</Enable>
    </LLHLS>
  </Modules>

  <Bind>
    <Managers>
      <API>
        <Port>8081</Port>
        <WorkerCount>1</WorkerCount>
      </API>
    </Managers>

    <Providers>
      <RTMP>
        <Port>1935</Port>
        <WorkerCount>1</WorkerCount>
      </RTMP>
      <SRT>
        <Port>9999</Port>
        <WorkerCount>1</WorkerCount>
      </SRT>
      <WebRTC>
        <Signalling>
          <Port>3333</Port>
          <WorkerCount>1</WorkerCount>
        </Signalling>
        <IceCandidates>
          <IceCandidate>${env:OME_HOST_IP:127.0.0.1}:10000-10005/udp</IceCandidate>
          <TcpRelay>${env:OME_HOST_IP:127.0.0.1}:3478</TcpRelay>
          <TcpForce>false</TcpForce>
          <TcpRelayWorkerCount>1</TcpRelayWorkerCount>
        </IceCandidates>
      </WebRTC>
    </Providers>

    <Publishers>
      <OVT>
        <Port>9000</Port>
        <WorkerCount>1</WorkerCount>
      </OVT>
      <LLHLS>
        <Port>3333</Port>
        <WorkerCount>1</WorkerCount>
      </LLHLS>
      <WebRTC>
        <Signalling>
          <Port>3333</Port>
          <WorkerCount>1</WorkerCount>
        </Signalling>
        <IceCandidates>
          <IceCandidate>${env:OME_HOST_IP:127.0.0.1}:10000-10005/udp</IceCandidate>
          <TcpRelay>${env:OME_HOST_IP:127.0.0.1}:3478</TcpRelay>
          <TcpForce>false</TcpForce>
          <TcpRelayWorkerCount>1</TcpRelayWorkerCount>
        </IceCandidates>
      </WebRTC>
    </Publishers>
  </Bind>

  <Managers>
    <API>
      <AccessToken>digistream-ome-access-token</AccessToken>
      <CrossDomains>
        <Url>*</Url>
      </CrossDomains>
    </API>
  </Managers>

  <VirtualHosts>
    <VirtualHost>
      <Name>default</Name>
      <Distribution>local.digistream</Distribution>

      <Host>
        <Names>
          <Name>*</Name>
        </Names>
      </Host>

      <SignedPolicy>
        <PolicyQueryKeyName>policy</PolicyQueryKeyName>
        <SignatureQueryKeyName>signature</SignatureQueryKeyName>
        <SecretKey>digistream-local-signed-policy</SecretKey>
        <Enables>
          <Publishers>webrtc,llhls</Publishers>
        </Enables>
      </SignedPolicy>

      <CrossDomains>
        <Url>*</Url>
      </CrossDomains>

      <Applications>
        <Application>
          <Name>live</Name>
          <Type>live</Type>

          <OutputProfiles>
            <OutputProfile>
              <Name>audio_delivery</Name>
              <OutputStreamName>${OriginStreamName}</OutputStreamName>
              <Encodes>
                <Audio>
                  <Name>aac</Name>
                  <Codec>aac</Codec>
                  <Bitrate>128000</Bitrate>
                  <Samplerate>48000</Samplerate>
                  <Channel>2</Channel>
                  <BypassIfMatch>
                    <Codec>eq</Codec>
                  </BypassIfMatch>
                </Audio>
                <Audio>
                  <Name>opus</Name>
                  <Codec>opus</Codec>
                  <Bitrate>128000</Bitrate>
                  <Samplerate>48000</Samplerate>
                  <Channel>2</Channel>
                  <BypassIfMatch>
                    <Codec>eq</Codec>
                  </BypassIfMatch>
                </Audio>
              </Encodes>
            </OutputProfile>
          </OutputProfiles>

          <Providers>
            <RTMP />
            <SRT />
            <WebRTC />
          </Providers>

          <Publishers>
            <AppWorkerCount>1</AppWorkerCount>
            <StreamWorkerCount>4</StreamWorkerCount>
            <WebRTC>
              <Timeout>30000</Timeout>
              <Rtx>false</Rtx>
              <Ulpfec>false</Ulpfec>
              <JitterBuffer>false</JitterBuffer>
            </WebRTC>
            <LLHLS>
              <ChunkDuration>0.5</ChunkDuration>
              <PartHoldBack>1.5</PartHoldBack>
              <SegmentDuration>2</SegmentDuration>
              <SegmentCount>6</SegmentCount>
              <CrossDomains>
                <Url>*</Url>
              </CrossDomains>
            </LLHLS>
            <OVT />
          </Publishers>
        </Application>
      </Applications>
    </VirtualHost>
  </VirtualHosts>
</Server>
