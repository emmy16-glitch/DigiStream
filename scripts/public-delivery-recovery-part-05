    '.github/workflows/apply-public-delivery-recovery.yml',
    'scripts/apply-public-delivery-recovery.py',
    'scripts/apply-public-delivery-recovery.trigger',
]:
    path = ROOT / relative
    if path.exists():
        path.unlink()
