{
  "name": "@digistream/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@digistream/contracts": "*",
    "@fastify/cors": "^11.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
